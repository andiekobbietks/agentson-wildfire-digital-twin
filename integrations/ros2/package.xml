<?xml version="1.0"?>
<package format="3">
  <name>wildfire_bridge</name>
  <version>0.2.0</version>
  <description>ROS 2 integration for the wildfire digital twin.</description>
  <maintainer email="maintainers@example.invalid">Wildfire Digital Twin maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <!-- Optional PX4 adapter: install px4_msgs from the matching PX4 release branch. -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
